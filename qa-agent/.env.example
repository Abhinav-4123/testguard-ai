# TestGuard AI Configuration

# ===========================================
# SERVER
# ===========================================
PORT=8080
ALLOWED_ORIGINS=https://vibesecurity.in,https://app.vibesecurity.in
APP_URL=https://app.vibesecurity.in

# ===========================================
# LLM PROVIDER CONFIGURATION
# ===========================================
# Set which provider to use: "gemini", "openai", "anthropic", or "auto"
# "auto" tries each in order until one works (cheapest first)
LLM_PROVIDER=auto

# Gemini (Google) - cheapest, recommended
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ===========================================
# ALERTS & NOTIFICATIONS
# ===========================================
SLACK_WEBHOOK_URL=

# Email (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# ===========================================
# STRIPE BILLING
# ===========================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=price_starter
STRIPE_GROWTH_PRICE_ID=price_growth
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise

# ===========================================
# SCHEDULED TESTS (pipe-separated: url|objective)
# ===========================================
SCHEDULED_TESTS=

# ===========================================
# TEST DATA (Stripe test card defaults)
# ===========================================
TEST_CARD_NUMBER=4111111111111111
TEST_CARD_EXP=12/28
TEST_CARD_CVV=123
